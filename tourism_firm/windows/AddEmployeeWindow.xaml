<Window x:Class="tourism_firm.AddEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:tourism_firm"
        mc:Ignorable="d"
        Title="Добавление сотрудника" Width="302" Height="410"
        ResizeMode="NoResize">

    <Grid Height="428" VerticalAlignment="Top" HorizontalAlignment="Center" Width="274">

        <TextBlock Text="Логин:" Margin="15,28,205,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="LoginTextBox" Margin="76,28,15,0" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Пароль:" Margin="15,61,202,0" Height="18" VerticalAlignment="Top"/>
        <PasswordBox x:Name="PasswordBox" Margin="76,61,15,0" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Фамилия:" Margin="15,124,203,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="LastNameTextBox" Margin="76,124,15,0" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Имя:" Margin="15,93,222,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="FirstNameTextBox" Width="182" Margin="76,93,0,0" HorizontalAlignment="Left" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Отчество:" Margin="15,154,202,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="MiddleNameTextBox" Width="182" Margin="76,154,0,0" HorizontalAlignment="Left" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Телефон:" Margin="15,219,202,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="PhoneTextBox" Width="182" Margin="76,219,0,0" HorizontalAlignment="Left" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Email:" Margin="15,187,202,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="EmailTextBox" Width="182" Margin="76,187,0,0" HorizontalAlignment="Left" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Роль:" Margin="15,254,202,0" Height="18" VerticalAlignment="Top"/>
        <ComboBox x:Name="RoleComboBox" Margin="76,253,15,0" SelectedIndex="0" Height="24" VerticalAlignment="Top">
            <ComboBoxItem Content="Сотрудник"/>
            <ComboBoxItem Content="Администратор"/>
        </ComboBox>

        <Button x:Name="SaveButton" Content="Сохранить" Click="SaveButton_Click" Margin="0,294,0,0" HorizontalAlignment="Center" Width="150" Height="28" VerticalAlignment="Top"/>
        <Button x:Name="CancelButton" Content="Отмена" Click="CancelButton_Click" HorizontalAlignment="Center" Width="150" Height="28" VerticalAlignment="Top" Margin="0,337,0,0"/>

    </Grid>
</Window>
