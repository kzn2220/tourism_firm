<Window x:Class="tourism_firm.AllOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:tourism_firm"
        mc:Ignorable="d"
        Title="Все заказы" Width="1000" Height="650" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Height="634" VerticalAlignment="Center" HorizontalAlignment="Left" Width="1000">
        <TextBlock Text="Все заказы" FontSize="20" FontWeight="Bold" VerticalAlignment="Top" Margin="20,20,0,0" HorizontalAlignment="Left" Width="122"/>
        <Button x:Name="BackButton" Content="Назад" Click="BackButton_Click" Margin="0,20,30,586" HorizontalAlignment="Right" Width="89"/>

        <Button x:Name="DeleteButton" Content="Удалить" Click="DeleteButton_Click" Margin="0,20,147,586" HorizontalAlignment="Right" Width="89"/>

        <DataGrid x:Name="OrdersDataGrid" Margin="0,62,0,0" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер заказа" Binding="{Binding OrderId}" Width="100"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientFullName}" Width="150"/>
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeFullName}" Width="150"/>
                <DataGridTextColumn Header="Название тура" Binding="{Binding TourName}" Width="250"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalCost, StringFormat='N2'}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>