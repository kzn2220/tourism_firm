<Window x:Class="tourism_firm.EmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:tourism_firm"
        mc:Ignorable="d"
        Title="Сотрудник" Width="1000" Height="650" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid Height="634" VerticalAlignment="Center" HorizontalAlignment="Left" Width="1000">
        <TextBlock Text="Доступные туры" FontSize="20" VerticalAlignment="Top" Margin="20,20,0,0" HorizontalAlignment="Left" Width="156"/>
        <Button x:Name="AllOrdersButton" Content="Все заказы" Width="120" Margin="461,20,419,583" Click="AllOrdersButton_Click"/>
        <Button x:Name="AllClientsButton" Content="Список клиентов" Width="140" Click="AllClientsButton_Click" Margin="595,20,265,583"/>

        <TextBlock Text="Страна:" Margin="15,61,925,0" VerticalAlignment="Top" Height="23"/>
        <TextBox x:Name="CountryTextBox" Width="120" Margin="74,61,806,550"/>
        <TextBlock Text="Макс. цена:" Margin="206,61,717,0" VerticalAlignment="Top" Height="23"/>
        <TextBox x:Name="MaxPriceTextBox" Margin="292,61,616,550"/>
        <Button x:Name="SearchButton" Content="Поиск" Click="SearchButton_Click" Margin="677,61,235,550"/>

        <TextBlock Text="Мин. кол-во доступных мест:" Margin="396,61,439,0" VerticalAlignment="Top" Height="23"/>
        <TextBox x:Name="MinAmountSeatsTextBox" Margin="566,61,345,550"/>

        <Button x:Name="DropFilterButton" Content="Сбросить" Click="DropFilterButton_Click" Margin="783,61,129,550"/>

        <Button x:Name="CreateOrderButton" Content="Оформить заказ" Click="CreateOrderButton_Click" Margin="749,20,129,583"/>

        <DataGrid x:Name="ToursDataGrid" Margin="0,89,0,0" AutoGenerateColumns="False" 
          CanUserAddRows="False" CanUserDeleteRows="False" Width="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding TourName}" Width="250"/>
                <DataGridTextColumn Header="Страна" Binding="{Binding Country}" Width="110"/>
                <DataGridTextColumn Header="Город" Binding="{Binding City}" Width="110"/>
                <DataGridTextColumn Header="Отель" Binding="{Binding Hotel}" Width="110"/>
                <DataGridTextColumn Header="Дата вылета" Binding="{Binding DepartureDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                <DataGridTextColumn Header="Дата возврата" Binding="{Binding ReturnDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                <DataGridTextColumn Header="Цена за место" Binding="{Binding Price, StringFormat='N2'}" Width="100"/>
                <DataGridTextColumn Header="Доступные места" Binding="{Binding AvailableSeats}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="BackToAutorizationButton" Content="Выйти" Margin="0,20,20,0" VerticalAlignment="Top" Click="BackToAutorizationButton_Click" Height="31" BorderBrush="#FF707070" Background="#FFFFC3C3" HorizontalAlignment="Right" Width="80"/>
    </Grid>
</Window>