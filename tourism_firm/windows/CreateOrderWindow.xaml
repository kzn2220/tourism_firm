<Window x:Class="tourism_firm.CreateOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:tourism_firm"
        mc:Ignorable="d"
        Title="Оформление заказа" Width="361" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid HorizontalAlignment="Center" Width="361" Height="384" VerticalAlignment="Bottom">
        <TextBlock Text="Оформление заказа" FontSize="16" FontWeight="Bold" Margin="97,17,0,337" HorizontalAlignment="Left" Width="158"/>

        <TextBlock Margin="47,57,214,304" Text="Название тура: "/>
        <TextBox x:Name="TourNameTextBox" TextWrapping="Wrap" Margin="148,57,47,304" Background="#00000000" IsReadOnly="True"/>

        <TextBlock Text="Клиент:" Margin="47,91,214,270"/>
        <ComboBox x:Name="ClientComboBox" DisplayMemberPath="FullName" Margin="148,91,47,270"/>

        <TextBlock Text="Скидка:" Margin="47,161,213,200"/>
        <ComboBox x:Name="DiscountComboBox" Margin="148,161,47,200" SelectedIndex="0" SelectionChanged="ClientComboBox_SelectionChanged">
            <ComboBoxItem Content="Нет скидки"/>
            <ComboBoxItem Content="Студент (10%)"/>
            <ComboBoxItem Content="Пенсионер (15%)"/>
            <ComboBoxItem Content="Постоянный клиент (5%)"/>
            <ComboBoxItem Content="Юридическое лицо (8%)"/>
        </ComboBox>

        <TextBlock Text="Способ оплаты:" Margin="47,196,213,165"/>
        <ComboBox x:Name="PaymentComboBox" Margin="148,196,47,165" SelectedIndex="0" SelectionChanged="ClientComboBox_SelectionChanged">
            <ComboBoxItem Content="Наличные"/>
            <ComboBoxItem Content="Банковская карта"/>
        </ComboBox>

        <TextBlock Text="Итого к оплате:" FontWeight="Bold" VerticalAlignment="Top" Margin="47,239,207,0"/>
        <TextBlock x:Name="TotalPriceText" Text="0 руб." 
                 FontWeight="Bold" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="240,236,0,0"/>

        <Button x:Name="ConfirmButton" Content="Оформить заказ" Width="120" Margin="120,271,121,79" Click="ConfirmButton_Click"/>
        <Button x:Name="CancelButton" Content="Отмена" Click="CancelButton_Click" Margin="120,321,121,29"/>
        
        <TextBlock Margin="47,126,214,236" Text="Количество мест: "/>
        <TextBox x:Name="SeatsAmountTextBox" TextWrapping="Wrap" Margin="148,126,47,236" Background="#00000000" TextChanged="SeatsAmountTextBox_TextChanged"/>
    </Grid>
</Window>