<Window x:Class="tourism_firm.AddClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:tourism_firm"
        mc:Ignorable="d"
        Title="Добавление клиента" Width="273" Height="387"
        ResizeMode="NoResize">

    <Grid Height="397" VerticalAlignment="Center" HorizontalAlignment="Center" Width="273">

        <TextBlock Text="Логин:" Margin="15,44,205,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="LoginTextBox" Margin="82,44,15,0" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Пароль:" Margin="15,77,202,0" Height="18" VerticalAlignment="Top"/>
        <PasswordBox x:Name="PasswordBox" Margin="82,77,15,0" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Фамилия:" Margin="15,140,203,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="LastNameTextBox" Margin="82,140,15,0" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Имя:" Margin="15,109,222,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="FirstNameTextBox" Width="176" Margin="82,109,0,0" HorizontalAlignment="Left" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Отчество:" Margin="15,170,202,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="MiddleNameTextBox" Width="176" Margin="82,170,0,0" HorizontalAlignment="Left" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Телефон:" Margin="15,235,202,0" Height="17" VerticalAlignment="Top"/>
        <TextBox x:Name="PhoneTextBox" Width="176" Margin="82,235,0,0" HorizontalAlignment="Left" Height="17" VerticalAlignment="Top"/>

        <TextBlock Text="Email:" Margin="15,204,202,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="EmailTextBox" Width="176" Margin="82,204,0,0" HorizontalAlignment="Left" Height="18" VerticalAlignment="Top"/>

        <Button x:Name="RegisterClientButton" Content="Зарегистрировать" Click="RegisterClientButton_Click" Margin="0,281,0,0" HorizontalAlignment="Center" Width="150" Height="28" VerticalAlignment="Top"/>
        <Button x:Name="CancelButton" Content="Отмена" Click="CancelButton_Click" HorizontalAlignment="Center" Width="150" Height="28" VerticalAlignment="Top" Margin="0,325,0,0"/>

    </Grid>
</Window>
