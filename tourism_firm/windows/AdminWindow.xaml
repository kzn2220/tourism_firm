<Window x:Class="tourism_firm.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:tourism_firm"
        mc:Ignorable="d"
        Title="Администратор" Width="1000" Height="650"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid HorizontalAlignment="Center" Width="1000" Height="634" VerticalAlignment="Center">

        <TextBlock Text="Скачать отчёт" VerticalAlignment="Top" FontWeight="Bold" FontSize="16" Margin="17,13,0,0" HorizontalAlignment="Left" Width="117"/>

        <TextBlock Text="С:" VerticalAlignment="Top" Margin="18,48,968,0" Height="23"/>
        <DatePicker x:Name="FromDatePicker" Width="110" Margin="37,48,853,563"/>

        <TextBlock Text="По:" VerticalAlignment="Top" Margin="165,47,809,0" Height="24"/>
        <DatePicker x:Name="ToDatePicker" Width="110" Margin="191,47,699,563"/>

        <ComboBox x:Name="ReportTypeComboBox" Margin="326,47,509,563" SelectedIndex="0">
            <ComboBoxItem Content="Продажи по турам"/>
            <ComboBoxItem Content="Статистика сотрудников"/>
        </ComboBox>

        <Button x:Name="GenerateReportButton" Content="Сформировать" Click="GenerateReportButton_Click" Margin="521,47,374,563"/>

        <Button x:Name="ManageToursButton" Content="Управление турами" Width="130" Margin="854,68,16,541" Click="ManageToursButton_Click"/>

        <TextBlock Text="Список сотрудников" FontSize="16" FontWeight="Bold" VerticalAlignment="Top" Margin="16,110,807,0"/>
        <Button x:Name="RegisterEmployeeButton" Content="Зарегистрировать сотрудника" Click="RegisterEmployeeButton_Click" Margin="791,105,16,503"/>
        <Button x:Name="DeleteButton" Content="Удалить" Click="DeleteButton_Click" Margin="675,105,230,503"/>
        <Button x:Name="EditButton" Content="Изменить" Click="EditButton_Click" Margin="560,105,344,503"/>

        <DataGrid x:Name="EmployeesDataGrid" Margin="0,136,0,0" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="120"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="120"/>
                <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="120"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="100"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="100"/>
                <DataGridTextColumn Header="Роль" Width="100" Binding="{Binding RoleName}"/>
            </DataGrid.Columns>
        </DataGrid>


        <Button x:Name="BackToAutorizationButton" Content="Выйти" Margin="0,13,13,0" VerticalAlignment="Top" Click="BackToAutorizationButton_Click" Height="31" BorderBrush="#FF707070" Background="#FFFFC3C3" HorizontalAlignment="Right" Width="80"/>
    </Grid>
</Window>