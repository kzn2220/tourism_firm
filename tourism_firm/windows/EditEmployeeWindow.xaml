<Window x:Class="tourism_firm.windows.EditEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:tourism_firm.windows"
        mc:Ignorable="d"
                Title="Изменение данных" Width="302" Height="360"
    ResizeMode="NoResize">

    <Grid Height="342" VerticalAlignment="Top" HorizontalAlignment="Center" Width="274">

        <TextBlock Text="Фамилия:" Margin="15,66,203,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="LastNameTextBox" Margin="76,66,15,0" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Имя:" Margin="15,35,222,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="FirstNameTextBox" Width="182" Margin="76,35,0,0" HorizontalAlignment="Left" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Отчество:" Margin="15,96,202,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="MiddleNameTextBox" Width="182" Margin="76,96,0,0" HorizontalAlignment="Left" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Телефон:" Margin="15,161,202,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="PhoneTextBox" Width="182" Margin="76,161,0,0" HorizontalAlignment="Left" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Email:" Margin="15,129,202,0" Height="18" VerticalAlignment="Top"/>
        <TextBox x:Name="EmailTextBox" Width="182" Margin="76,129,0,0" HorizontalAlignment="Left" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Роль:" Margin="15,195,202,0" Height="18" VerticalAlignment="Top"/>
        <ComboBox x:Name="RoleComboBox" Margin="76,194,15,0" SelectedIndex="0" Height="24" VerticalAlignment="Top">
            <ComboBoxItem Content="Сотрудник"/>
            <ComboBoxItem Content="Администратор"/>
        </ComboBox>

        <Button x:Name="SaveButton" Content="Сохранить" Click="SaveButton_Click" Margin="0,236,0,0" HorizontalAlignment="Center" Width="150" Height="28" VerticalAlignment="Top"/>
        <Button x:Name="CancelButton" Content="Отмена" Click="CancelButton_Click" HorizontalAlignment="Center" Width="150" Height="28" VerticalAlignment="Top" Margin="0,279,0,0"/>

    </Grid>
</Window>
