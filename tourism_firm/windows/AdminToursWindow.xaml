<Window x:Class="tourism_firm.AdminToursWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:tourism_firm"
        mc:Ignorable="d"
        Title="Управление турами" Width="1000" Height="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid HorizontalAlignment="Center" Width="1000" Height="634" VerticalAlignment="Center">
        <TextBlock Text="Управление турами" FontSize="20" Margin="20,20,772,0" Height="28" VerticalAlignment="Top"/>
        <Button x:Name="BackButton" Content="Назад" Click="BackButton_Click" Margin="0,0,20,586" Height="28" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="69"/>

        <TextBlock Text="Добавить новый тур" FontWeight="Bold" Margin="20,54,829,0" Height="22" VerticalAlignment="Top"/>

        <TextBlock Text="Название:" VerticalAlignment="Top" Margin="20,81,916,0" Height="26"/>
        <TextBox x:Name="TourNameTextBox" Margin="84,81,741,527"/>

        <TextBlock Text="Страна:" VerticalAlignment="Top" Margin="20,116,916,0" Height="26"/>
        <TextBox x:Name="CountryTextBox" Margin="84,116,741,492"/>

        <TextBlock Text="Город:" VerticalAlignment="Top" Margin="20,152,916,0" Height="26"/>
        <TextBox x:Name="CityTextBox" Margin="84,152,741,456"/>

        <TextBlock Text="Отель:" VerticalAlignment="Top" Margin="296,81,612,0" Height="21"/>
        <TextBox x:Name="HotelTextBox" Margin="393,81,455,527"/>

        <TextBlock Text="Дата вылета:" VerticalAlignment="Top" Margin="296,116,612,0" Height="26"/>
        <DatePicker x:Name="DepartureDateDatePicker" Margin="393,116,455,492"/>

        <TextBlock Text="Дата возврата:" VerticalAlignment="Top" Margin="296,152,612,0" Height="26"/>

        <DatePicker x:Name="ReturnDateDatePicker" Margin="393,152,455,456"/>

        <TextBlock Text="Цена за место:" VerticalAlignment="Top" Margin="581,81,326,0" Height="26"/>
        <TextBox x:Name="PriceTextBox" Margin="688,81,199,527"/>

        <TextBlock Text="Доступные места:" VerticalAlignment="Top" Margin="581,116,317,0" Height="26"/>
        <TextBox x:Name="AvailableSeatsTextBox" Margin="688,116,199,0" Height="26" VerticalAlignment="Top"/>

        <Button x:Name="AddTourButton" Content="Добавить" Margin="632,152,254,0" Height="26" Click="AddTourButton_Click" VerticalAlignment="Top"/>
        <Button x:Name="DeleteTourButton" Content="Удалить" Margin="866,81,20,0" Height="26" Click="DeleteTourButton_Click" VerticalAlignment="Top"/>
        <Button x:Name="EditTourButton" Content="Изменить" Margin="866,116,20,0" Height="26" Click="EditTourButton_Click" VerticalAlignment="Top"/>

        <DataGrid x:Name="ToursDataGrid" Margin="0,183,0,0" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False" Width="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding TourName}" Width="190"/>
                <DataGridTextColumn Header="Страна" Binding="{Binding Country}" Width="110"/>
                <DataGridTextColumn Header="Город" Binding="{Binding City}" Width="110"/>
                <DataGridTextColumn Header="Отель" Binding="{Binding Hotel}" Width="110"/>
                <DataGridTextColumn Header="Дата вылета" Binding="{Binding DepartureDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                <DataGridTextColumn Header="Дата возврата" Binding="{Binding ReturnDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                <DataGridTextColumn Header="Цена за место" Binding="{Binding Price, StringFormat='N2'}" Width="100"/>
                <DataGridTextColumn Header="Доступные места" Binding="{Binding AvailableSeats}" Width="120"/>
                <DataGridTextColumn Header="Архив" Binding="{Binding Status}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>