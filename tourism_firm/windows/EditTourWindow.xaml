<Window x:Class="tourism_firm.EditTourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:tourism_firm"
        mc:Ignorable="d"
            Title="Изменение данных" Width="868" Height="184"
    WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid HorizontalAlignment="Left" Width="1000" Height="634" VerticalAlignment="Top">

        <TextBlock Text="Название:" VerticalAlignment="Top" Margin="20,31,916,0" Height="26"/>
        <TextBox x:Name="TourNameTextBox" Margin="84,31,741,577"/>

        <TextBlock Text="Страна:" VerticalAlignment="Top" Margin="20,66,916,0" Height="26"/>
        <TextBox x:Name="CountryTextBox" Margin="84,66,741,542"/>

        <TextBlock Text="Город:" VerticalAlignment="Top" Margin="20,102,916,0" Height="26"/>
        <TextBox x:Name="CityTextBox" Margin="84,102,741,506"/>

        <TextBlock Text="Отель:" VerticalAlignment="Top" Margin="296,31,612,0" Height="21"/>
        <TextBox x:Name="HotelTextBox" Margin="393,31,455,577"/>

        <TextBlock Text="Дата вылета:" VerticalAlignment="Top" Margin="296,66,612,0" Height="26"/>
        <DatePicker x:Name="DepartureDateDatePicker" Margin="393,66,455,542"/>

        <TextBlock Text="Дата возврата:" VerticalAlignment="Top" Margin="296,102,612,0" Height="26"/>

        <DatePicker x:Name="ReturnDateDatePicker" Margin="393,102,455,506"/>

        <TextBlock Text="Цена:" VerticalAlignment="Top" Margin="581,31,347,0" Height="26"/>
        <TextBox x:Name="PriceTextBox" Margin="688,31,169,577"/>

        <TextBlock Text="Количество мест:" VerticalAlignment="Top" Margin="581,66,317,0" Height="26"/>
        <TextBox x:Name="SeatsTextBox" Margin="688,66,169,0" Height="26" VerticalAlignment="Top"/>

        <Button x:Name="SaveButton" Content="Сохранить" Margin="581,102,305,0" Height="26" Click="SaveButton_Click" VerticalAlignment="Top"/>
        <Button x:Name="CancelButton" Content="Отменить" Margin="717,102,169,0" Height="26" Click="CancelButton_Click" VerticalAlignment="Top"/>
    </Grid>
</Window>
