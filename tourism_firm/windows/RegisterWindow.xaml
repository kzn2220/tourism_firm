<Window x:Class="tourism_firm.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:tourism_firm"
        mc:Ignorable="d"
        Title="Регистрация" Width="273" Height="413"
        ResizeMode="NoResize">

    <Grid>
        <TextBlock Text="Регистрация" FontSize="20" Margin="0,10,0,0" Height="27" VerticalAlignment="Top" HorizontalAlignment="Center" Width="120"/>

        <TextBlock Text="Логин:" Margin="10,62,0,0" Height="18" VerticalAlignment="Top" HorizontalAlignment="Left" Width="53"/>
        <TextBox x:Name="LoginTextBox" Margin="0,62,10,0" Height="18" VerticalAlignment="Top" HorizontalAlignment="Right" Width="163"/>

        <TextBlock Text="Пароль:" Margin="10,95,0,0" Height="18" VerticalAlignment="Top" HorizontalAlignment="Left" Width="56"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,95,10,0" Height="18" VerticalAlignment="Top" HorizontalAlignment="Right" Width="163"/>

        <TextBlock Text="Фамилия:" Margin="10,158,0,0" Height="18" VerticalAlignment="Top" HorizontalAlignment="Left" Width="55"/>
        <TextBox x:Name="LastNameTextBox" Margin="0,158,10,0" Height="18" VerticalAlignment="Top" HorizontalAlignment="Right" Width="163"/>

        <TextBlock Text="Имя:" Margin="10,127,0,0" Height="18" VerticalAlignment="Top" HorizontalAlignment="Left" Width="36"/>
        <TextBox x:Name="FirstNameTextBox" Margin="0,127,10,0" Height="18" VerticalAlignment="Top" HorizontalAlignment="Right" Width="163"/>

        <TextBlock Text="Отчество:" Margin="10,188,0,0" Height="18" VerticalAlignment="Top" HorizontalAlignment="Left" Width="56"/>
        <TextBox x:Name="MiddleNameTextBox" Width="163" Margin="0,188,10,0" HorizontalAlignment="Right" Height="18" VerticalAlignment="Top"/>

        <TextBlock Text="Телефон:" Margin="10,253,0,0" Height="17" VerticalAlignment="Top" HorizontalAlignment="Left" Width="56"/>
        <TextBox x:Name="PhoneTextBox" Width="163" Margin="0,253,10,0" HorizontalAlignment="Right" Height="17" VerticalAlignment="Top"/>

        <TextBlock Text="Email:" Margin="10,221,0,0" Height="18" VerticalAlignment="Top" HorizontalAlignment="Left" Width="56"/>
        <TextBox x:Name="EmailTextBox" Width="163" Margin="0,221,10,0" HorizontalAlignment="Right" Height="18" VerticalAlignment="Top"/>

        <Button x:Name="RegisterButton" Content="Зарегистрироваться" Click="RegisterButton_Click" Margin="0,0,0,65" HorizontalAlignment="Center" Width="150" Height="28" VerticalAlignment="Bottom"/>
        <Button x:Name="CancelButton" Content="Отмена" Click="CancelButton_Click" HorizontalAlignment="Center" Width="150" Margin="0,0,0,21" Height="28" VerticalAlignment="Bottom"/>

    </Grid>
</Window>