<Window x:Class="tourism_firm.AllClientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:tourism_firm"
        mc:Ignorable="d"
        Title="Список клиентов" Width="1000" Height="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Height="634" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="1000">
        <TextBlock Text="Список клиентов" FontSize="20" FontWeight="Bold" VerticalAlignment="Top" Margin="20,28,0,0" HorizontalAlignment="Left" Width="175"/>
        <Button x:Name="BackButton" Content="Назад" Click="BackButton_Click" Margin="0,28,20,578" HorizontalAlignment="Right" Width="89"/>
        <Button x:Name="DeleteButton" Content="Удалить" Click="DeleteButton_Click" Margin="0,28,137,578" HorizontalAlignment="Right" Width="89"/>
        <Button x:Name="EditButton" Content="Изменить" Click="EditButton_Click" Margin="0,28,425,578" HorizontalAlignment="Right" Width="89"/>

        <Button x:Name="RegisterClientButton" Content="Зарегистрировать клиента" Click="RegisterClientButton_Click" Margin="0,28,244,578" HorizontalAlignment="Right" Width="164"/>

        <DataGrid x:Name="ClientsDataGrid" Margin="0,72,0,0" AutoGenerateColumns="False" 
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="120"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="120"/>
                <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="120"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>